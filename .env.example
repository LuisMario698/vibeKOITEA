# ---------- Koi Tea · variables de entorno ----------
# Copia este archivo a .env.local y llena lo que uses. Todo es opcional:
# sin Supabase el menú usa los datos estáticos de src/lib/menu/data.ts y los
# pedidos se mandan solo por WhatsApp (enlace wa.me).

# URL pública del sitio (para metadata, Open Graph y los enlaces de Stripe)
NEXT_PUBLIC_SITE_URL=https://koitea.mx

# WhatsApp del negocio al que llegan los pedidos (solo dígitos, con lada: 52 + 10 dígitos)
NEXT_PUBLIC_WHATSAPP=
# Instagram y datos del negocio (si los dejas vacíos se usan los de src/lib/menu/data.ts)
NEXT_PUBLIC_INSTAGRAM=koitea.mx

# ---------- Supabase (menú editable, pedidos y panel de administración) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor: crea pedidos y los lee por código
SUPABASE_SERVICE_ROLE_KEY=
# Correos que pueden entrar al panel (separados por coma). También se puede usar la tabla staff.
ADMIN_EMAILS=

# ---------- Stripe (pago exprés con Apple Pay / Google Pay y tarjeta) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Mercado Pago (Checkout Pro) ----------
MP_ACCESS_TOKEN=

# ---------- WhatsApp Business API (aviso automático al equipo y al cliente) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEAM_NUMBER=
WHATSAPP_VERIFY_TOKEN=
