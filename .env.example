# ---------- Koi Tea · variables de entorno ----------
# Copia este archivo a .env.local y llena lo que uses. Todo es opcional:
# sin Supabase el menú usa los datos estáticos de src/lib/menu/data.ts y los
# pedidos se mandan solo por WhatsApp (enlace wa.me), con pago en barra.

# URL pública del sitio (metadata, Open Graph y regreso de los pagos).
# Déjala vacía en local (usa http://localhost:3000) y en Vercel ponla en el proyecto: https://koitea.mx
NEXT_PUBLIC_SITE_URL=

# WhatsApp del negocio al que llegan los pedidos (solo dígitos, con lada: 52 + 10 dígitos)
NEXT_PUBLIC_WHATSAPP=
# Instagram y datos del negocio (si los dejas vacíos se usan los de src/lib/menu/data.ts)
NEXT_PUBLIC_INSTAGRAM=koitea.mx

# ---------- Supabase (menú editable, pedidos y panel de administración) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor: crea y lee pedidos. Sin ella no hay seguimiento en vivo ni pago en línea.
SUPABASE_SERVICE_ROLE_KEY=
# Correos que pueden entrar al panel (separados por coma). Se agregan solos a la tabla staff la primera vez que entran.
ADMIN_EMAILS=

# ---------- Stripe (pago exprés con Apple Pay / Google Pay y tarjeta) · requiere Supabase ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Mercado Pago (Checkout Pro) · requiere Supabase ----------
MP_ACCESS_TOKEN=

# ---------- WhatsApp Business API (aviso automático al equipo y al cliente) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEAM_NUMBER=
# Texto que inventas tú y escribes igual en Meta al registrar el webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta: valida que los avisos del webhook vengan de WhatsApp
WHATSAPP_APP_SECRET=
# Nombre de la plantilla aprobada para avisar al cliente que su pedido está listo (es_MX / en_US, un parámetro: el código)
WHATSAPP_READY_TEMPLATE=
